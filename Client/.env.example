# Production / Staging Environment Configuration Template
# Copy this file to .env or set these environment variables in your deployment platform (Vercel, Netlify, AWS, Render, Docker, etc.)

# Backend API Base Endpoint (e.g. https://api.yourdomain.com/api/v1)
VITE_API_URL=https://api.yourdomain.com/api/v1

# Socket.IO Real-time Connection Server URL (e.g. https://api.yourdomain.com)
VITE_SOCKET_URL=https://api.yourdomain.com

# Enable Automatic Mock Service Fallback (Set to 'false' in Production)
VITE_ENABLE_MOCK_FALLBACK=false
